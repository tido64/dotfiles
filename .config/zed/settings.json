// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "features": {
    "inline_completion_provider": "none"
  },
  "buffer_font_size": 13,
  "ui_font_size": 16,
  "wrap_guides": [80, 100],
  "collaboration_panel": {
    "button": false
  },
  "chat_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "assistant": {
    "version": "2",
    "enabled": false
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "tabs": {
    "close_position": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "file_types": {
    "JavaScript": ["*.jsbundle"],
    "Ruby": ["*.podspec"],
    "Shell Script": ["*.env"],
    "XML": [
      "*.appxmanifest",
      "*.props",
      "*.targets",
      "*.vcxproj.filters",
      "*.wapproj",
      "packages.config"
    ],
    "YAML": [".clang-format"]
  },
  "languages": {
    "Kotlin": {
      "format_on_save": "off"
    }
  },
  "jupyter": {
    "enabled": false
  }
}
